{
  "$schema": "https://turbo.build/api/config.json",
  "tasks": {
    "dev:api": {
      "persistent": true,
      "cache": false
    },
    "dev:web": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    }
  }
}
