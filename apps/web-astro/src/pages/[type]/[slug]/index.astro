---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChapterSection from '@/components/ChapterSection';
import BookmarkButton from '@/components/BookmarkButton';
import SourceSwitcher from '@/components/SourceSwitcher';
import Synopsis from '@/components/Synopsis';
import SourceBadge, { SOURCE_LABELS } from '@/components/SourceBadge';
import { TYPE_META, TypeBadge } from '@/components/TypeBadge';
import NotFoundPage from '@/components/pages/NotFoundPage';
import { loadCanonical } from '@/lib/loadCanonical';
import { API_URL } from '@/lib/api';

export const prerender = false;

const { type, slug } = Astro.params;

// 404 asli (pre-render body) bila slug tak dikenal — bukan soft-404.
let notFound = false;
let loaded: Awaited<ReturnType<typeof loadCanonical>> | null = null;
try {
  loaded = await loadCanonical(slug!, Astro.request.headers.get('cookie') ?? undefined);
} catch {
  notFound = true;
}
if (loaded && loaded.resolved.type !== type) {
  // Wrong-type → redirect permanen ke route typed yang benar (301).
  return Astro.redirect(`/${loaded.resolved.type}/${encodeURIComponent(slug)}`, 301);
}
const resolved = loaded?.resolved ?? { slug: '', type: 'manga', source: '', sourceSlug: '', recommendedSource: null, sources: [] };
const series = loaded?.detail ?? { slug: '', external_id: '', source: '', title: '', type: '', status: '' } as any;
const chapters = loaded?.chapters ?? [];
const sources = loaded?.sources ?? null;

const desc = (series.synopsis ?? '').replace(/\s+/g, ' ').trim().slice(0, 160) || undefined;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: series.title,
  image: series.cover_image,
  author: series.author && series.author !== '-' ? { '@type': 'Person', name: series.author } : undefined,
  genre: series.genres ?? [],
  inLanguage: 'id',
}).replaceAll('<', '\\u003c');

const genres: string[] = series.genres ?? [];
const author = series.author;
const allSources = (resolved.sources ?? []).length > 0
  ? [resolved.source, ...(resolved.sources ?? []).map((s) => s.source).filter((s) => s !== resolved.source)]
  : [resolved.source];

// Mulai Baca → chapter pertama (chapter_number terkecil).
const startChapter = chapters.length > 0
  ? chapters.reduce((min, c) => (c.chapter_number < min.chapter_number ? c : min))
  : null;
const startChapterId = startChapter
  ? (startChapter.id.includes(':') ? startChapter.id.slice(startChapter.id.lastIndexOf(':') + 1) : startChapter.id)
  : null;

const srcAgg = sources && sources.sources.length > 1 ? sources : null;

if (notFound) Astro.response.status = 404;
---

{notFound ? (
  <BaseLayout title="404 — Halaman tidak ditemukan" noindex>
    <NotFoundPage client:load />
  </BaseLayout>
) : (
  <BaseLayout title={series.title} description={desc} canonical={`/${type}/${slug}`}>
  <main class="max-w-2xl mx-auto px-4 pb-28">
    <script type="application/ld+json" set:html={jsonLd} />

    <a href="/" class="text-secondary text-sm hover:text-accent mb-4 inline-block">← Beranda</a>

    {/* Poster + info — mobile: stacked centered; md+: split */}
    <div class="md:flex md:gap-6 md:items-start mb-5">
      {series.cover_image && (
        <div class="flex justify-center md:shrink-0 mb-4 md:mb-0">
          <img
            src={series.cover_image}
            alt={series.title}
            loading="lazy"
            decoding="async"
            class="w-36 h-52 object-cover rounded-xl border border-border-default shadow-lg"
          />
        </div>
      )}

      <div class="text-center md:text-left flex-1 min-w-0">
        <h1 class="text-xl font-semibold text-primary leading-snug">{series.title}</h1>
        {author && author !== '-' && (
          <p class="text-secondary text-sm mt-1">{author}</p>
        )}

        {/* Meta badges — type (flag+glow) + status dengan indikator jelas */}
        <div class="flex items-center justify-center md:justify-start flex-wrap gap-2 mt-2.5">
          <TypeBadge type={series.type} />
          <span class="inline-flex items-center gap-1.5 text-[10px] font-medium px-2 py-1 rounded border border-border-default text-secondary capitalize">
            <span class={`inline-block h-1.5 w-1.5 rounded-full ${series.status === 'ongoing' ? 'bg-success animate-pulse' : 'bg-muted'}`} aria-hidden="true" />
            {series.status || 'N/A'}
          </span>
          <SourceBadge sources={allSources} size="sm" primary={resolved.source} />
        </div>
      </div>
    </div>

    {/* Synopsis — bordered box, collapsible */}
    {series.synopsis && (
      <div class="mb-4">
        <Synopsis text={series.synopsis} client:visible />
      </div>
    )}

    <div class="border-t border-border-subtle my-4"></div>

    {/* Detail Info */}
    <div class="mb-4">
      <h2 class="font-mono text-[10px] font-black uppercase tracking-[0.2em] text-muted mb-3">Detail Info</h2>
      <div class="divide-y divide-border-subtle text-sm">
        <div class="py-2.5">
          <span class="block font-mono text-[10px] font-black uppercase tracking-[0.2em] text-muted mb-1">Type</span>
          <span class="inline-flex items-center gap-1.5 text-primary font-semibold capitalize">
            {series.type ? (
              <>
                <span aria-hidden="true">{TYPE_META[series.type.toLowerCase()]?.flag ?? ''}</span>
                {series.type}
              </>
            ) : (
              <span class="text-secondary font-normal">N/A</span>
            )}
          </span>
        </div>
        <div class="py-2.5">
          <span class="block font-mono text-[10px] font-black uppercase tracking-[0.2em] text-muted mb-1">Status</span>
          <span class="text-secondary capitalize">{series.status || 'N/A'}</span>
        </div>
        <div class="py-2.5">
          <span class="block font-mono text-[10px] font-black uppercase tracking-[0.2em] text-muted mb-1">Source</span>
          <span class="flex flex-wrap gap-1.5">
            {allSources.length > 0 ? (
              allSources.map((s) => (
                <span class="inline-flex items-center gap-1.5 rounded-md bg-card/70 border border-border-subtle px-2 py-1 text-[10px] font-black uppercase tracking-wide text-secondary">
                  <SourceBadge sources={[s]} size="sm" />
                  {SOURCE_LABELS[s] ?? s}
                </span>
              ))
            ) : (
              <span class="text-secondary">N/A</span>
            )}
          </span>
        </div>
        <div class="py-2.5">
          <span class="block font-mono text-[10px] font-black uppercase tracking-[0.2em] text-muted mb-1">Author</span>
          <span class="text-secondary">{author && author !== '-' ? author : 'N/A'}</span>
        </div>
        <div class="py-2.5">
          <span class="block font-mono text-[10px] font-black uppercase tracking-[0.2em] text-muted mb-1">Genre</span>
          <span class="flex flex-wrap gap-1.5">
            {genres.length > 0 ? (
              genres.map((g: string) => (
                <span class="rounded-md border border-border-subtle bg-card/70 px-2.5 py-1 text-[10px] font-black uppercase tracking-wide text-secondary">{g}</span>
              ))
            ) : (
              <span class="text-secondary">N/A</span>
            )}
          </span>
        </div>
      </div>
    </div>

    <div class="border-t border-border-subtle my-4"></div>

    {/* Chapter list — interaktif (sheet) */}
    <ChapterSection
      client:load
      initialChapters={chapters}
      recSource={sources?.recommendedSource ?? null}
      recSourceSlug={null}
      source={resolved.source}
      sourceSlug={resolved.sourceSlug}
      slug={resolved.slug}
      type={type!}
      apiUrl={API_URL}
    />

    {/* Source switcher section */}
    {srcAgg && (
      <div class="mt-4">
        <p class="text-xs text-muted mb-2">{srcAgg.sources.length} sumber · terbanyak {srcAgg.sources.reduce((m, l) => Math.max(m, l.chapterCount ?? 0), 0)} chapter</p>
        <SourceSwitcher
          client:load
          currentSource={resolved.source}
          sourceId={resolved.sourceSlug}
          canonicalSlug={resolved.slug}
          chapterNumber={0}
          apiUrl={API_URL}
          mode="detail"
          links={srcAgg.sources}
          recommendedSource={srcAgg.recommendedSource}
          type={type}
        />
      </div>
    )}

    {/* Toolbox — floating bottom bar: bookmark + Mulai Baca */}
    {startChapterId && (
      <div class="fixed inset-x-0 bottom-4 z-40 flex justify-center px-4">
        <div class="nav-island flex w-full max-w-md items-center gap-2 rounded-xl p-2 shadow-[0_8px_32px_rgba(0,0,0,0.45)]">
          <BookmarkButton client:idle slug={slug!} title={series.title} cover={series.cover_image} source={resolved.source} />
          <a
            href={`/${type}/${slug}/${startChapterId}`}
            class="inline-flex h-11 flex-1 items-center justify-center gap-1.5 rounded-lg border border-white bg-white px-5 text-sm font-semibold text-black hover:opacity-90 transition-opacity"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            Mulai Baca
          </a>
        </div>
      </div>
    )}
  </main>
</BaseLayout>
)}
