---
import { API_URL, getResolve, getChapter, getSeries } from '@/lib/api';
import ReaderShell from '@/components/ReaderShell';
import NotFoundPage from '@/components/pages/NotFoundPage';
import NotFoundShell from '@/components/NotFoundShell.astro';

export const prerender = false;

const { type, slug, chapterId } = Astro.params;

// Canonical chapter reader: getResolve → getChapter(recommended/chosen).
// ChapterId URL kanonik adalah raw id (typedChapterUrl memangkas prefix
// `source:`). 404 asli bila resolve/chapter gagal — dirender inline
// (bukan rewrite ke /404 prerendered — forbidden di server output).
let notFound = false;
let resolved: Awaited<ReturnType<typeof getResolve>> | null = null;
try {
  resolved = await getResolve(slug!);
} catch {
  notFound = true;
}
if (resolved && resolved.type !== type) {
  return Astro.redirect(`/${resolved.type}/${encodeURIComponent(slug!)}/${encodeURIComponent(chapterId!)}`, 301);
}

let chapter = null;
let readSource = '';
let sourceSlug = '';
if (resolved) {
  const src0 = resolved.recommendedSource ?? resolved.source;
  const link = resolved.sources.find((l) => l.source === src0);
  sourceSlug = link?.sourceSlug ?? resolved.sourceSlug;

  // Chapter id hidup di namespace per-source; coba chosen source dulu,
  // fallback ke source kanonik bila id tidak ada di sana.
  const candidates = [...new Set([src0, resolved.source])];
  readSource = candidates[0];
  for (const src of candidates) {
    try {
      const got = await getChapter(src, chapterId!);
      if (got) {
        chapter = got;
        readSource = src;
        break;
      }
    } catch {
      // coba kandidat berikutnya
    }
  }
  if (!chapter || !chapter.pages || chapter.pages.length === 0) notFound = true;
}

const readSlug = resolved && readSource === resolved.source ? resolved.sourceSlug : sourceSlug;
const series = chapter && resolved ? await getSeries(readSource, readSlug).catch(() => null) : null;

const chapterNum = chapter?.chapter_number ?? 0;
const pages = (chapter?.pages || []).map((p) => ({ ...p }));

if (notFound) Astro.response.status = 404;
---

{notFound ? (
  <NotFoundShell title="404 — Halaman tidak ditemukan">
    <NotFoundPage client:load />
  </NotFoundShell>
) : (
  <html lang="id" class="dark">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{`${series?.title || slug} — Ch. ${chapterNum} - Oktz.`}</title>
      <meta name="robots" content="noindex, nofollow" />
      <link rel="canonical" href={`/${type}/${slug}/${chapterId}`} />
    </head>
    <body class="min-h-screen bg-base text-primary antialiased">
      <ReaderShell
        client:load
        source={readSource}
        slug={readSlug}
        chapterId={chapterId!}
        chapterNumber={chapterNum}
        chapterTitle={chapter?.title}
        seriesTitle={series?.title || slug!}
        seriesType={series?.type}
        type={resolved!.type}
        pages={pages}
        apiUrl={API_URL}
      />
    </body>
  </html>
)}
