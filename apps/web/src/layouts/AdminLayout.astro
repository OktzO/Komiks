---
// Admin shell: topbar fixed, navbar utama disembunyikan (bare layout).
// Topbar client island untuk pathname-based active state.
import { ClientRouter } from 'astro:transitions';
import AdminTopbar from '@/components/pages/AdminTopbar';
import ThemeInit from '@/components/ThemeInit.astro';
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} - Oktz. Admin`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/logo-96.webp" type="image/webp" />
    <ClientRouter fallback="swap" />
    <script src="@/scripts/nav-skeleton.ts"></script>
  </head>
  <body class="bg-base text-primary min-h-screen antialiased">
    {/* client:only — SSR React admin islands kena CPU limit 10ms worker free
        (measured 22-48ms cold) → error 1102 → 503 intermiten (2026-09-15).
        Admin noindex, tak butuh SEO; render penuh di client. */}
    <AdminTopbar client:only="react">
      <div style="max-width:72rem;margin:0 auto;padding:3rem 1rem;font-size:.875rem;opacity:.6">Memuat navigasi…</div>
    </AdminTopbar>
    <main class="admin-page px-4 md:px-6 py-8">
      <slot />
    </main>
  </body>
</html>
