---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MangaCard } from '@/components/MangaCard';
import { CoverImage } from '@/components/CoverImage';
import { TypeBadge } from '@/components/TypeBadge';
import { SourceBadge } from '@/components/SourceBadge';
import { HeroSpotlight } from '@/components/HeroSpotlight';
import { BentoGrid } from '@/components/BentoGrid';
import ContinueReadingRail from '@/components/ContinueReadingRail';
import { GenrePills } from '@/components/GenrePills';
import { fetchHomepage, safeType, typedUrl, statusKnown, statusLabel } from '@/lib/api';

export const prerender = true;

const itemOf = (m: any) => m.data ?? m;

let manga: any[] = [];
let feedError: string | null = null;
try {
  const res = await fetchHomepage();
  manga = res.data || [];
} catch (e: unknown) {
  feedError = e instanceof Error ? e.message : String(e);
}

const sortedPopular = [...manga].sort((a, b) => (b.popularity ?? 0) - (a.popularity ?? 0));
const bentoItems = sortedPopular.slice(0, 5);
const carouselItems = sortedPopular.slice(5, 17);
const updates = manga.slice(10, 26);
---

<BaseLayout>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 pb-20 overflow-x-hidden">
    {/* High-End Hero Spotlight */}
    <HeroSpotlight />

    {/* Continue Reading Rail (Client Side - instant from localStorage/session) */}
    <ContinueReadingRail client:idle />

    {/* Genre Categories Navigator */}
    <GenrePills />

    {/* Main Feed */}
    {feedError && (
      <div class="text-error text-sm border border-border-default rounded-lg p-4 bg-card mb-8">
        Gagal memuat katalog: {feedError}
      </div>
    )}

    {!feedError && manga.length === 0 && (
      <div class="space-y-12" aria-busy="true">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          <div class="lg:col-span-7 h-[360px] skeleton rounded-xl"></div>
          <div class="lg:col-span-5 grid grid-cols-2 gap-3.5">
            {Array.from({ length: 4 }).map(() => (
              <div class="h-40 w-full skeleton rounded-xl"></div>
            ))}
          </div>
        </div>
        <div>
          <div class="h-6 w-48 skeleton rounded mb-4"></div>
          <div class="flex gap-4 overflow-hidden">
            {Array.from({ length: 6 }).map(() => (
              <div class="h-56 w-36 sm:w-40 shrink-0 skeleton rounded-lg"></div>
            ))}
          </div>
        </div>
        <div>
          <div class="h-6 w-48 skeleton rounded mb-4"></div>
          <div class="grid md:grid-cols-2 gap-4">
            {Array.from({ length: 6 }).map(() => (
              <div class="h-20 w-full skeleton rounded-lg"></div>
            ))}
          </div>
        </div>
      </div>
    )}

    {/* Ticker marquee */}
    {updates.length > 0 && (
      <section aria-label="Judul terbaru" class="marquee relative mb-12 overflow-hidden border-y border-border-subtle py-3.5 bg-card/30">
        <div class="marquee-track">
          {[0, 1].map((copy) => (
            <div class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
              {updates.slice(0, 10).map((m) => {
                const it = itemOf(m);
                return (
                  <span class="flex items-center shrink-0">
                    <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-secondary whitespace-nowrap">{it.title}</span>
                    <span class="mx-6 h-3 w-px bg-border-subtle" />
                  </span>
                );
              })}
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Bento Grid: Featured Spotlight */}
    {bentoItems.length >= 5 && <BentoGrid items={bentoItems} />}

    {/* Populer Hari Ini - horizontal scroll */}
    {carouselItems.length > 0 && (
      <section class="mb-14">
        <div class="flex items-baseline justify-between mb-5">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Trending Sekarang</span>
          </div>
          <a href="/search?sort=popular" class="text-xs sm:text-sm text-secondary hover:text-accent transition-colors font-mono">
            Semua populer →
          </a>
        </div>
        <div class="flex gap-4 overflow-x-auto pb-4 snap-x" style="scrollbar-width: thin" aria-label="Judul populer">
          {carouselItems.map((m) => {
            const item = itemOf(m);
            const source = (m.sources?.includes('komiku') ?? item.sources?.includes('komiku')) ? 'komiku' : item.source;
            return (
              <div class="shrink-0 snap-start w-36 sm:w-44">
                <MangaCard
                  manga={{ id: item.slug, title: item.title, cover: item.cover_image || null, slug: item.slug }}
                  source={source}
                  sources={(m.sources as string[]) || (item.sources as string[]) || [item.source]}
                  type={item.type}
                />
              </div>
            );
          })}
        </div>
      </section>
    )}

    {/* Update Terbaru - 2-col enhanced list */}
    {updates.length > 0 && (
      <section class="cv-feed mb-14">
        <div class="flex items-baseline justify-between mb-5">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Baru Diperbarui</span>
          </div>
          <a href="/search?sort=latest" class="text-xs sm:text-sm text-secondary hover:text-accent transition-colors font-mono">
            Semua update →
          </a>
        </div>
        <div class="grid md:grid-cols-2 gap-3.5">
          {updates.map((m) => {
            const item = itemOf(m);
            return (
              <a
                href={typedUrl(safeType(item.type), item.slug)}
                class="bento-card flex items-center gap-3.5 p-3 group hover:border-border-default transition-all"
              >
                <div class="w-12 h-16 shrink-0 overflow-hidden rounded border border-border-subtle bg-bg-secondary">
                  <CoverImage src={item.cover_image} alt={item.title} title={item.title} className="h-full w-full" zoom />
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium text-primary truncate group-hover:text-accent transition-colors">
                    {item.title}
                  </div>
                  <div class="flex items-center gap-2 mt-1.5">
                    <TypeBadge type={item.type} />
                    {statusKnown(item.status) && <span class="text-[11px] text-muted font-mono">{statusLabel(item.status)}</span>}
                  </div>
                </div>
                <SourceBadge sources={(m.sources as string[]) || (item.sources as string[]) || [item.source]} size="sm" />
              </a>
            );
          })}
        </div>
      </section>
    )}
    </main>
</BaseLayout>
